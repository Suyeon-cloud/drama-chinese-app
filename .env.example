# 追剧学汉语 환경변수 예시 — 실제 값은 이 파일이 아니라 배포 환경(Vercel 등)이나 .env.local에 넣는다.
# (.env·.env.local은 git에 올라가지 않는다. 이 파일에는 값을 넣지 않는다)
# [브라우저] = 빌드에 포함되어 공개되는 값 / [서버] = 서버에서만 읽는 값(VITE_ 접두사 금지)

# ───── 저장소 ─────
# [서버·필수] supabase: 회원·과목·분반·수강·학습자료·학습 기록·피드백을 모두 Supabase에 둔다. (db.json·DATA_DIR 불필요)
#              비워 두거나 dbjson이면 예전 방식(data/db.json)으로 동작한다.
AUTH_BACKEND=supabase

# ───── Supabase ─────
# [브라우저·필수] 프로젝트 주소와 anon(publishable) 키 — 학생·교수자 Google 로그인(Supabase Auth)에 쓴다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# [서버·필수] 같은 프로젝트 주소. 서버가 학생·교수자 token을 확인하고 관리자 기능을 처리할 때 쓴다.
SUPABASE_URL=
# [서버·선택] 비워 두면 VITE_SUPABASE_ANON_KEY를 쓴다.
SUPABASE_ANON_KEY=
# [서버·필수·비밀] service-role 키 — 관리자 API에서만 쓴다. 절대 VITE_ 접두사를 붙이지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# ───── 관리자 (Google과 별개인 아이디·비밀번호 로그인) ─────
# [서버·필수·비밀]
ADMIN_ID=
ADMIN_PASSWORD=
# [서버·필수·비밀] 관리자 로그인 쿠키 서명용 임의의 긴 문자열. supabase에서는 이 값이 없으면 관리자 로그인이 꺼진다.
SESSION_SECRET=
# [서버·선택] 관리자가 Gmail 피드백을 보낼 Google 이메일. 비워 두면 보낼 때 고른 계정으로 보낸다.
ADMIN_EMAIL=

# ───── Gmail 피드백 발송 (Google Identity Services, 학생·교수자 로그인과 별개) ─────
# [공개·필수(Gmail 발송 시)] Google OAuth 클라이언트 ID (웹 애플리케이션). 서버가 /config로 브라우저에 알려 준다.
GOOGLE_CLIENT_ID=
# [브라우저·선택] 빌드에 넣는 같은 값. 서버 설정을 읽지 못할 때만 쓴다. 보통 비워 둔다.
VITE_GOOGLE_CLIENT_ID=

# ───── AI 학습 콘텐츠 생성 ─────
# [서버·선택·비밀] Anthropic API 키. supabase에서는 이 환경변수로만 설정한다. (화면·DB에 저장하지 않는다)
ANTHROPIC_API_KEY=

# ───── 예전 방식(dbjson)·이전 작업 전용 — supabase 운영에는 필요 없다 ─────
# [dbjson] 회원·학습 데이터를 저장할 폴더. 비워 두면 ./data
# DATA_DIR=
# [dbjson·C2 이전 스크립트] 이 Google 이메일을 교수자로 등록한다.
# INITIAL_INSTRUCTOR_EMAIL=
