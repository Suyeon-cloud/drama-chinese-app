# Google OAuth 클라이언트 ID (웹 애플리케이션 유형) — 구글 로그인과 Gmail 발송에 사용
GOOGLE_CLIENT_ID=

# 관리자 로그인 (구글 계정과 별개). 화면 오른쪽 위 ‘관리자’ 아이콘으로 로그인한다.
ADMIN_ID=
ADMIN_PASSWORD=

# (선택) 관리자가 Gmail 피드백을 보낼 Google 이메일. 비워 두면 보낼 때 고른 계정으로 보낸다.
ADMIN_EMAIL=

# (선택) 로그인 쿠키 서명용 임의의 긴 문자열. 비워 두면 서버가 만들어 data/db.json에 보관한다.
SESSION_SECRET=

# (선택) 이 Google 이메일로 로그인하면 교수자(관리자) 화면이 열린다. 승인 절차 없이 바로 사용.
INITIAL_INSTRUCTOR_EMAIL=

# (선택) 회원·학습 데이터를 저장할 폴더. Railway에서는 Volume 경로(/data)를 넣는다. 비워 두면 ./data
DATA_DIR=

# (선택) Anthropic API 키 — AI 학습 콘텐츠 생성. 비워 두면 관리자 모드 화면에서 본인 키를 연결한다.
ANTHROPIC_API_KEY=
